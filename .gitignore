# For PCBs designed using KiCad: https://www.kicad.org/
# Format documentation: https://kicad.org/help/file-formats/

# Temporary files
*.000
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*-backups
*-cache*
*-bak
*-bak*
*~
~*
_autosave-*
\#auto_saved_files\#
*.tmp
*-save.pro
*-save.kicad_pcb
fp-info-cache
~*.lck
\#auto_saved_files#

# Netlist files (exported from Eeschema)
*.net

# Autorouter files (exported from Pcbnew)
*.dsn
*.ses

# Exported BOM files
*.xml
*.csv

# Archived Backups (KiCad 6.0)
**/*-backups/*.zip

# Local git-based history (KiCad 9.0+)
.history

# Local project settings
*.kicad_prl

# --- Anadido en la reorganizacion del 25-sep-2026 ---
# Historial local de VS Code (variante no cubierta por .history)
.history_trim/

# Snapshots de trabajo (superados por el control de versiones)
Hardware - copia/

# Instaladores de plugins de terceros
com.github.*.zip

# Gerbers comprimidos: se versiona la carpeta Gerbers-Pot/, no el zip
Gerbers-*.zip

# Datasheets: viven en Datasheets/ (compartida con el resto del equipo),
# no sueltos en Hardware-Potencia/
Hardware-Potencia/*.pdf

# Simulacion: exports crudos de LTspice (~20 GB) y salidas binarias pesadas
# que superan el limite de 100 MB de GitHub. Se regeneran desde los .asc.
simulacion/exports/
simulacion/**/*.raw
simulacion/**/*.7z
simulacion/**/*.db
