{
  "names": {
    "rmw_microxrcedds": {
      "cmake-args": [
        "-DRMW_UXRCE_MAX_NODES=1",
        "-DRMW_UXRCE_MAX_PUBLISHERS=6",
        "-DRMW_UXRCE_MAX_SUBSCRIPTIONS=6",
        "-DRMW_UXRCE_MAX_SERVICES=6",
        "-DRMW_UXRCE_MAX_CLIENTS=0",
        "-DRMW_UXRCE_MAX_HISTORY=4",
        "-DRMW_UXRCE_STREAM_HISTORY=8"
      ]
    },
    "rclc_parameter": {
      "cmake-args": [
        "-DRCLC_PARAMETER_MAX_STRING_LENGTH=100"
      ]
    }
  }
}
