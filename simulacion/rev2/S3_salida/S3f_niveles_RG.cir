S3f EXTRA S3c: Rrst 10k a source con RG 2.2k/4.7k/10k (reponer V_GS bajando RG), C gd 100n + D
.include S3f_common.inc
.options solver=alt method=modtrap
.param TCLOSE=1m TLOAD=20m TEND=80m TSRCOFF=1e3 CGD=100n RST=10k RQ7=1m CQ7=1p RSTG=1G RDON=1 RPRE=1G
.step param VN list 6.8 12 25
.step temp list 25 100
.step param RG list 2.2k 4.7k 10k
Iload vext 0 PWL(0 0 {TLOAD} 0 {TLOAD+10u} 8)
Vctl ctl 0 PULSE(0 1 {TCLOSE} 1n 1n 1 2)
.tran 0 {TEND} 0 2u
.meas tran vgs6 avg V(g6)-V(vint) from=70m to=80m
.meas tran vgs7 avg V(gq7) from=70m to=80m
.meas tran vds6 avg V(vint)-V(vdr) from=70m to=80m
.meas tran id6 avg I(Vid) from=70m to=80m
.meas tran p6 avg (V(vint)-V(vdr))*I(Vid) from=70m to=80m
.meas tran rds6 param vds6/id6*1000
.meas tran vint avg V(vint) from=70m to=80m
.meas tran pz avg (V(vint)-V(g6))*(-I(DZ6)) from=70m to=80m
.meas tran pl2 avg I(Rl2)*I(Rl2)*4.7k from=70m to=80m
.meas tran pl3 avg I(Rl3)*I(Rl3)*4.7k from=70m to=80m
.meas tran il2 avg I(Rl2) from=70m to=80m
.meas tran ig6 avg I(Rg6) from=70m to=80m
.meas tran pgood avg V(pgood) from=70m to=80m
.meas tran vm avg V(m)-V(vint) from=70m to=80m
.meas tran vdsq6off avg V(vint)-V(vdr) from=70m to=80m
.end
